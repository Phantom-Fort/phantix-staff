# ── Staff Portal (staff.phantix.site) ────────────────────────────────────────
# Staff JWT only (type=staff) — never company/org-user/app tokens
VITE_API_BASE=https://staging.phantix.site/api/v1

# Cross-surface links
# VITE_APP_URL=https://app.phantix.site
# VITE_PLATFORM_URL=https://platform.phantix.site
# AGI master switch (mirrors backend PHANTIX_AGI_ENABLED). Set VITE_AGI_ENABLED=false to hide AGI surfaces.
VITE_AGI_ENABLED=true

# Landing sandbox apply API (Node service in ../sandbox-apply-api)
# VITE_SANDBOX_APPLY_API=http://localhost:8787
# VITE_SANDBOX_STAFF_KEY=change-me-to-a-long-random-string
